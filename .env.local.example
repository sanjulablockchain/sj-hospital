# SMTP credentials for the contact and careers forms (sent via Nodemailer).
# Copy this file to .env.local and fill in real values there. That file is
# gitignored and must never be committed.
#
# Microsoft 365: host smtp.office365.com, port 587. That port is STARTTLS
# rather than implicit TLS, so the transport leaves `secure` false and sets
# `requireTLS` instead (see src/lib/mailer.ts).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Microsoft 365 rejects a From the authenticated mailbox has no Send As right
# over, so keep this the same account as SMTP_USER.
SMTP_FROM="St. Joseph Hospital Careers <smtp.example@example.com>"

# Comma-separated recipients for contact form submissions.
CONTACT_TO_EMAILS=admin@example.com,alerts@example.com

# Comma-separated recipients for careers page job applications (CV attached).
CAREER_TO_EMAILS=hr@example.com
